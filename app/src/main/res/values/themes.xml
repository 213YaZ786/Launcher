<resources>
    <!-- The window is transparent over the wallpaper: windowBackground transparent and windowShowWallpaper, as Trebuchet's
         BaseLauncherTheme (https://github.com/LineageOS/android_packages_apps_Trebuchet/blob/lineage-22.2/res/values/styles.xml). -->
    <style name="Theme.Launcher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
