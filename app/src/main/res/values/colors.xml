<resources>
    <!-- The launcher icon follows the wallpaper, as Store's, Dialer's, SMS's and Contacts' do: the disc in the accent.
         The ground is the disc's own tone (the disc's rim grey is white), so no pale ring shows around it, whatever the mask. -->
    <color name="ic_launcher_disc">@android:color/system_accent1_500</color>
    <color name="ic_launcher_background">@android:color/system_accent1_500</color>
    <color name="ic_launcher_glyph">@android:color/system_accent1_600</color>
</resources>
