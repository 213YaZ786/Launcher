<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher's launcher glyph, as Store's: a glossy disc filling the launcher's circle, with Material Symbols' "apps" grid
     of nine dots, each one of the user's ivory 3D spheres (Modules/icons/launcher/export.py writes the layers).
     The disc's grey body is multiplied by a tone of the wallpaper's accent, its white rim lights it, untinted,
     and the dots lie on top as drawn. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:src="@drawable/launcher_body"
            android:tint="@color/ic_launcher_disc"
            android:tintMode="multiply" />
    </item>
    <item android:drawable="@drawable/launcher_shine" />
    <item android:drawable="@drawable/launcher_dots" />
</layer-list>
